[submodule "services/contracts/hubpool-contract/lib/contracts"]
	path = services/contracts/hubpool-contract/lib/contracts
	url = https://github.com/across-protocol/contracts
[submodule "services/contracts/hubpool-contract/lib/openzeppelin-contracts"]
	path = services/contracts/hubpool-contract/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "services/contracts/hubpool-contract/lib/openzeppelin-contracts-upgradeable"]
	path = services/contracts/hubpool-contract/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "services/contracts/hubpool-contract/lib/protocol"]
	path = services/contracts/hubpool-contract/lib/protocol
	url = https://github.com/UMAprotocol/protocol
